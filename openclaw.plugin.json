{
  "id": "anspire-search_pro",
  "name": "Anspire AI Search Pro",
  "version": "0.1.1",
  "entry": "./dist/index.js",
  "skills": ["./skills"],
  "configSchema": {
    "type": "object",
    "properties": {
      "apiKey": {
        "type": "string",
        "description": "Anspire API key"
      },
      "baseUrl": {
        "type": "string",
        "description": "Anspire API base URL",
        "default": "https://plugin.anspire.cn"
      },
      "tavilyApiKey": {
        "type": "string",
        "description": "Tavily API key"
      },
      "tavilyBaseUrl": {
        "type": "string",
        "description": "Tavily API base URL",
        "default": "https://api.tavily.com"
      }
    },
    "additionalProperties": true
  }
}
